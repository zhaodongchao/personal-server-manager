  <dependencies>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-system</artifactId>
    </dependency>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-monitor</artifactId>
    </dependency>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-file</artifactId>
    </dependency>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-ops</artifactId>
    </dependency>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-appstack</artifactId>
    </dependency>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-tools</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>serverpanel</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
