<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.serverpanel</groupId>
    <artifactId>serverpanel-backend</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>server-appstack</artifactId>
  <name>ServerPanel :: AppStack</name>
  <description>应用栈管理：Docker 容器/镜像、MySQL 数据库</description>

  <dependencies>
    <dependency>
      <groupId>com.serverpanel</groupId>
      <artifactId>server-framework</artifactId>
    </dependency>
    <!-- Docker Engine API（unix socket） -->
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-transport-httpclient5</artifactId>
    </dependency>
    <!-- PostgreSQL JDBC 驱动：取号数据源在 PostgreSQL 侧走真连库取号（nextval）。
         驱动版本由 spring-boot-dependencies 统一管理，此处不写版本。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
  </dependencies>
</project>
